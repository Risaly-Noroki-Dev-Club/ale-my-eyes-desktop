import { Palette } from "std-widgets.slint";
import { Ui } from "state.slint";
export global AppTheme {
    private property <color> system-background: Palette.background;
    out property <bool> dark: root.system-background.to-oklch().lightness < 0.5;
    out property <color> background: root.dark ? #17151c : #fffbfe;
    out property <color> surface: root.dark ? #24212b : #ffffff;
    out property <color> soft: root.dark ? #302a3b : #f7f2fa;
    out property <color> accent: root.dark ? #d0bcff : #6750a4;
    out property <color> accent-text: root.dark ? #21005d : #ffffff;
    out property <color> selected: root.dark ? #45345f : #eaddff;
    out property <color> text: root.dark ? #f4effa : #1c1b1f;
    out property <color> muted: Ui.high-contrast ? root.text : root.dark ? #cac4d0 : #49454f;
    out property <color> border: Ui.high-contrast ? root.text : root.dark ? #79747e : #cac4d0;
    out property <color> warning: root.dark ? #523a14 : #ffddb3;
    out property <color> danger: root.dark ? #ffb4ab : #b3261e;
}
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> flat: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> modal-control: false;
    in property <bool> auto-focus: false;
    private property <bool> interactive: root.enabled && ((!Ui.leave-prompt && !Ui.test-prompt) || root.modal-control);
    callback clicked();
    min-height: 44px;
    min-width: content.min-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 22px;
    background: !root.enabled ? AppTheme.soft : touch.pressed ? AppTheme.selected
        : root.primary ? AppTheme.accent : root.selected || touch.has-hover ? AppTheme.selected : AppTheme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? AppTheme.accent : root.primary || root.selected || root.flat ? transparent : AppTheme.border;
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.interactive;
    accessible-action-default => { if root.interactive { root.clicked(); } }
    init => { if root.auto-focus { focus.focus(); } }
    content := HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 8px; alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon; width: 20px; height: 20px;
            y: (parent.height - self.height) / 2;
            colorize: root.primary ? AppTheme.accent-text : root.danger ? AppTheme.danger : AppTheme.text;
        }
        Text { text: root.text; font-size: 14px; color: root.primary ? AppTheme.accent-text : root.danger ? AppTheme.danger : AppTheme.text; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.interactive;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                if root.interactive { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.interactive; clicked => { focus.focus(); root.clicked(); } }
}
export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <bool> good: false;
    height: 28px; border-radius: 8px;
    horizontal-stretch: 0; vertical-stretch: 0;
    min-width: badge-layout.min-width;
    Rectangle {
    x: 0px; width: badge-layout.min-width; height: 28px; border-radius: 8px;
    background: root.good ? (AppTheme.dark ? #29491c : #c3efa5) : AppTheme.soft;
    badge-layout := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px;
        Rectangle { y: (parent.height - self.height) / 2; width: 7px; height: 7px; border-radius: 4px; background: root.good ? (AppTheme.dark ? #c3efa5 : #386a20) : AppTheme.muted; }
        Text { text: root.text; color: AppTheme.text; font-size: 12px; vertical-alignment: center; }
    }
    }
}
export component Panel inherits Rectangle {
    background: AppTheme.surface; border-radius: 16px;
    border-width: 1px; border-color: AppTheme.border;
    drop-shadow-blur: 6px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000012;
    @children
}
export component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <image> icon;
    padding: 20px; spacing: 10px;
    vertical-stretch: 0;
    if root.icon.width > 0: Image { source: root.icon; width: 22px; height: 22px; colorize: AppTheme.text; }
    Text { text: root.text; color: AppTheme.text; font-family: "Roboto Slab"; font-size: 18px; font-weight: 600; horizontal-stretch: 1; }
}
export component Field inherits GridLayout {
    in property <string> label;
    spacing: 12px;
    Text { row: 0; col: 0; text: root.label; color: AppTheme.muted; font-size: 14px; min-width: Ui.compact ? 0px : 128px; max-width: Ui.compact ? 10000px : 128px; wrap: word-wrap; }
    VerticalLayout {
        row: Ui.compact ? 1 : 0; col: Ui.compact ? 0 : 1; alignment: start; spacing: 8px;
        @children
    }
}
