import { Palette } from "std-widgets.slint";

export global AppTheme {
    in property <bool> high-contrast: false;
    in property <bool> is-mobile: false;
    in property <length> base-font: root.is-mobile ? 16px : 14px;
    in property <length> touch-min: root.is-mobile ? 44px : 28px;
    in property <length> pad: root.is-mobile ? 12px : 8px;
    in property <length> gap: root.is-mobile ? 8px : 4px;
}

export component StatusBadge inherits Rectangle {
    in property <string> text: "";
    in property <string> state: "ready";
    in property <bool> connected: false;

    height: 24px;
    border-radius: 12px;
    background: root.state == "speaking" ? #e8f5e9
        : root.state == "processing" ? #fff8e1
        : root.state == "error" ? #ffebee
        : root.state == "connected" ? #ede7f6
        : #f5f5f5;
    border-width: 1px;
    border-color: root.state == "speaking" ? #81c784
        : root.state == "processing" ? #ffd54f
        : root.state == "error" ? #e57373
        : root.state == "connected" ? #9575cd
        : Palette.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        // 状态圆点
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.state == "speaking" ? #4caf50
                : root.state == "processing" ? #ff9800
                : root.state == "error" ? #f44336
                : root.state == "connected" ? #7e57c2
                : #9e9e9e;
        }

        Text {
            text: "  " + root.text;
            font-size: AppTheme.base-font - 3px;
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    callback clicked;

    height: root.compact ? 28px : 36px;
    border-radius: root.compact ? 6px : 8px;
    background: !root.enabled ? Palette.border
        : root.primary ? #6b4c9a
        : Palette.control-background;
    border-width: root.primary ? 0px : 1px;
    border-color: Palette.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: root.compact ? 10px : 16px;
        padding-right: root.compact ? 10px : 16px;
        alignment: center;

        Text {
            text: root.text;
            font-size: AppTheme.base-font - 1px;
            color: !root.enabled ? Palette.foreground.transparentize(0.5)
                : root.primary ? #ffffff
                : Palette.foreground;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon: "";
    in property <string> tooltip: "";
    in property <bool> active: false;
    callback clicked;

    width: AppTheme.touch-min;
    height: AppTheme.touch-min;
    border-radius: 8px;
    background: touch.has-hover ? Palette.control-background : transparent;
    accessible-label: root.tooltip;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.icon;
        font-size: AppTheme.is-mobile ? 20px : 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.active ? Palette.accent-background : Palette.foreground;
    }
}

export component StatusDot inherits Rectangle {
    in property <string> state: "ready";
    width: root.state == "speaking" ? 12px : 10px;
    height: root.state == "speaking" ? 12px : 10px;
    border-radius: 6px;
    background: root.state == "speaking" ? #28a745
        : root.state == "processing" ? #ffc107
        : root.state == "error" ? #dc3545
        : root.state == "recording" ? #17a2b8
        : Palette.border;
}

export component TagPill inherits Rectangle {
    in property <string> label;
    in property <brush> accent: Palette.accent-background;
    height: 22px;
    border-radius: 11px;
    background: root.accent.transparentize(0.85);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.label;
            font-size: AppTheme.base-font - 3px;
            color: root.accent;
        }
    }
}
