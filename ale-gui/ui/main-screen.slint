import { AppTheme, IconButton, StatusBadge, ActionButton } from "widgets.slint";
import { Palette } from "std-widgets.slint";

export component MainScreen inherits Rectangle {
    in property <string> status-text: "就绪";
    in property <string> status-type: "ready";
    in property <string> vad-state: "silent";
    in property <string> transcription: "";
    in property <string> ai-response: "";
    in property <string> action-steps: "";
    in property <bool> show-confirmation: false;
    in property <string> confirmation-text: "";
    in property <bool> is-busy: false;
    in property <bool> engine-ready: false;
    in property <bool> listening-enabled: true;
    in property <string> capability-text: "";
    in property <int> session-tokens: 0;
    in property <string> remote-status: "";
    in property <bool> remote-connected: false;

    callback toggle-listening();
    callback confirm-action();
    callback cancel-action();
    callback open-settings();

    background: Palette.background;

    VerticalLayout {
        padding: AppTheme.pad + 4px;
        spacing: AppTheme.gap + 4px;

        // 顶部状态栏
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                StatusBadge {
                    text: root.vad-state == "speaking" ? "说话中"
                        : root.vad-state == "speech_ended" ? "处理中"
                        : root.is-busy ? root.status-text
                        : root.status-text;
                    state: root.vad-state == "speaking" ? "speaking"
                        : root.is-busy ? "processing"
                        : !root.engine-ready ? "error"
                        : "ready";
                }

                if root.remote-connected : StatusBadge {
                    text: "已连接";
                    state: "connected";
                }
            }

            IconButton {
                icon: root.listening-enabled ? "⏸" : "▶";
                tooltip: "切换监听";
                clicked => { root.toggle-listening(); }
            }

            IconButton {
                icon: "⚙";
                tooltip: "设置";
                clicked => { root.open-settings(); }
            }
        }

        // 转写区
        if root.transcription != "" : Rectangle {
            height: 26px;
            background: Palette.alternate-background;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: start;

                Text {
                    text: "🎙  " + root.transcription;
                    font-size: AppTheme.base-font - 2px;
                    color: Palette.foreground;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        // AI 回答区
        Rectangle {
            vertical-stretch: 1;
            background: Palette.control-background;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                if root.ai-response == "" && root.action-steps == "" : Text {
                    text: root.listening-enabled ? "等待语音指令..." : "监听已暂停";
                    font-size: AppTheme.base-font - 2px;
                    color: Palette.foreground.transparentize(0.45);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }

                if root.ai-response != "" : Text {
                    text: root.ai-response;
                    font-size: AppTheme.base-font - 2px;
                    color: Palette.foreground;
                    wrap: word-wrap;
                    overflow: elide;
                }

                if root.action-steps != "" : Text {
                    text: root.action-steps;
                    font-size: AppTheme.base-font - 4px;
                    color: Palette.accent-background;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        // 确认对话框
        if root.show-confirmation : Rectangle {
            height: 44px;
            background: Palette.accent-background.transparentize(0.92);
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.accent-background;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: "⚠  " + root.confirmation-text;
                    font-size: AppTheme.base-font - 2px;
                    color: Palette.foreground;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                ActionButton {
                    text: "确认执行";
                    primary: true;
                    compact: true;
                    clicked => { root.confirm-action(); }
                }

                ActionButton {
                    text: "取消";
                    compact: true;
                    clicked => { root.cancel-action(); }
                }
            }
        }

        // 底部信息栏
        HorizontalLayout {
            spacing: 8px;
            height: 24px;
            alignment: space-between;

            Text {
                text: root.capability-text;
                font-size: AppTheme.base-font - 4px;
                color: Palette.foreground.transparentize(0.5);
                vertical-alignment: center;
            }

            Text {
                text: "Token: " + root.session-tokens;
                font-size: AppTheme.base-font - 4px;
                color: Palette.foreground.transparentize(0.35);
                vertical-alignment: center;
            }
        }
    }
}
