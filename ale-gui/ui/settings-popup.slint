import { LineEdit, Button, CheckBox, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { AppTheme } from "widgets.slint";

export component SettingsPopup inherits Rectangle {
    in property <string> provider: "";
    in property <string> api-key: "";
    in property <string> api-url: "";
    in property <string> model: "";
    in property <string> wire-api: "chat_completions";
    in property <string> reasoning-effort: "";
    in property <bool> store-responses: false;
    in property <string> max-tokens-str: "4000";
    in property <bool> auto-speak: true;
    in property <bool> show-api-key: false;
    in property <bool> is-busy: false;
    in property <string> config-path: "";
    in property <string> remote-status: "";
    in property <bool> remote-connected: false;
    in property <image> remote-pairing-qr;
    in property <image> remote-scan-preview;
    in property <bool> remote-scanning: false;
    in property <bool> is-mobile: false;

    callback provider-changed(string);
    callback api-key-changed(string);
    callback api-url-changed(string);
    callback model-changed(string);
    callback wire-api-changed(string);
    callback reasoning-effort-changed(string);
    callback store-responses-changed(bool);
    callback max-tokens-changed(string);
    callback auto-speak-changed(bool);
    callback toggle-api-key-visible();
    callback save-settings();
    callback test-connection();
    callback scan-remote();
    callback cancel-remote-scan();
    callback disconnect-remote();
    callback close-settings();

    background: #000000.transparentize(0.5);

    Rectangle {
        width: 340px;
        height: 440px;
        background: Palette.background;
        border-radius: 12px;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 16px;
            spacing: AppTheme.gap + 2px;

            // 标题栏
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: "⚙ 设置";
                    font-size: AppTheme.base-font + 2px;
                    font-weight: 700;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
                Button {
                    text: "✕";
                    clicked => { root.close-settings(); }
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 10px;

                    // 云端 API
                    Text { text: "云端 API"; font-size: AppTheme.base-font; font-weight: 600; color: Palette.foreground; }

                    Text {
                        text: "Provider";
                        font-size: AppTheme.base-font - 2px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    LineEdit {
                        text: root.provider;
                        placeholder-text: "openai";
                        edited(text) => { root.provider-changed(text); }
                    }

                    Text {
                        text: "API Key";
                        font-size: AppTheme.base-font - 2px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text: root.api-key;
                            placeholder-text: "sk-...";
                            edited(text) => { root.api-key-changed(text); }
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: root.show-api-key ? "隐藏" : "显示";
                            clicked => { root.toggle-api-key-visible(); }
                        }
                    }

                    Text {
                        text: "API URL";
                        font-size: AppTheme.base-font - 2px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    LineEdit {
                        text: root.api-url;
                        placeholder-text: "https://api.openai.com/v1";
                        edited(text) => { root.api-url-changed(text); }
                    }

                    Text {
                        text: "Model";
                        font-size: AppTheme.base-font - 2px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    LineEdit {
                        text: root.model;
                        placeholder-text: "gpt-4o";
                        edited(text) => { root.model-changed(text); }
                    }

                    Text {
                        text: "API 协议";
                        font-size: AppTheme.base-font - 2px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    ComboBox {
                        model: ["chat_completions", "responses"];
                        current-value: root.wire-api;
                        selected(value) => { root.wire-api-changed(value); }
                    }

                    if root.wire-api == "responses" : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Reasoning effort（留空使用模型默认值）";
                            font-size: AppTheme.base-font - 2px;
                            color: Palette.foreground.transparentize(0.3);
                        }
                        ComboBox {
                            model: ["", "none", "minimal", "low", "medium", "high", "xhigh", "max"];
                            current-value: root.reasoning-effort;
                            selected(value) => { root.reasoning-effort-changed(value); }
                        }
                        CheckBox {
                            checked: root.store-responses;
                            text: "允许 API 服务端存储响应";
                            toggled => { root.store-responses-changed(self.checked); }
                        }
                    }

                    // Token 预算
                    Text { text: "Token 预算"; font-size: AppTheme.base-font; font-weight: 600; color: Palette.foreground; }
                    Text {
                        text: "上下文对话最大 token 数";
                        font-size: AppTheme.base-font - 2px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    LineEdit {
                        text: root.max-tokens-str;
                        placeholder-text: "4000";
                        edited(text) => { root.max-tokens-changed(text); }
                    }

                    // 界面选项
                    Text { text: "界面"; font-size: AppTheme.base-font; font-weight: 600; color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            checked: root.auto-speak;
                            text: "自动语音播报";
                            toggled => { root.auto-speak-changed(self.checked); }
                        }
                    }

                    Text { text: "局域网桌面端"; font-size: AppTheme.base-font; font-weight: 600; color: Palette.foreground; }
                    Text {
                        text: root.remote-status;
                        font-size: AppTheme.base-font - 2px;
                        color: root.remote-connected ? Palette.accent-background : Palette.foreground.transparentize(0.3);
                        wrap: word-wrap;
                    }
                    if !root.is-mobile : Image {
                        source: root.remote-pairing-qr;
                        width: 240px;
                        height: 240px;
                        image-fit: contain;
                    }
                    if root.is-mobile && root.remote-scanning : Image {
                        source: root.remote-scan-preview;
                        width: 240px;
                        height: 180px;
                        image-fit: cover;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if root.is-mobile : Button {
                            text: root.remote-scanning ? "取消扫描" : "扫描二维码";
                            enabled: root.remote-scanning || !root.is-busy;
                            clicked => {
                                if root.remote-scanning { root.cancel-remote-scan(); }
                                else { root.scan-remote(); }
                            }
                        }
                        if root.is-mobile : Button {
                            text: "断开";
                            enabled: root.remote-connected;
                            clicked => { root.disconnect-remote(); }
                        }
                    }

                    // 配置路径（只读）
                    if root.config-path != "" : VerticalLayout {
                        spacing: 4px;
                        Text { text: "配置文件"; font-size: AppTheme.base-font; font-weight: 600; color: Palette.foreground; }
                        Text {
                            text: root.config-path;
                            font-size: AppTheme.base-font - 4px;
                            color: Palette.foreground.transparentize(0.5);
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // 操作按钮
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "保存";
                    primary: true;
                    enabled: !root.is-busy;
                    clicked => { root.save-settings(); }
                }
                Button {
                    text: "测试连接";
                    enabled: !root.is-busy;
                    clicked => { root.test-connection(); }
                }
                Button {
                    text: "取消";
                    clicked => { root.close-settings(); }
                }
            }
        }
    }
}
