import { PairingScreen } from "pairing-screen.slint";
import { SettingsPopup } from "settings-popup.slint";
import { AppTheme } from "widgets.slint";
import { Palette } from "std-widgets.slint";

export { AppTheme }

export component AppWindow inherits Window {
    title: "Ale, My Eyes!";
    preferred-width: 420px;
    preferred-height: 520px;
    min-width: 390px;
    min-height: 500px;
    background: Palette.background;

    in-out property <string> status-text: "初始化中...";
    in-out property <string> status-type: "info";
    in-out property <string> vad-state: "silent";
    in-out property <string> transcription: "";
    in-out property <string> ai-response: "";
    in-out property <string> action-steps: "";
    in-out property <bool> show-confirmation: false;
    in-out property <string> confirmation-text: "";
    in-out property <bool> is-busy: false;
    in-out property <bool> engine-ready: false;
    in-out property <bool> listening-enabled: true;
    in-out property <string> capability-text: "";
    in-out property <int> session-tokens: 0;
    in-out property <int> max-tokens-budget: 4000;
    in-out property <string> text-input: "";

    in-out property <bool> show-settings: false;
    in-out property <string> provider: "";
    in-out property <string> api-key: "";
    in-out property <string> api-url: "";
    in-out property <string> model: "";
    in-out property <string> wire-api: "chat_completions";
    in-out property <string> reasoning-effort: "";
    in-out property <bool> store-responses: false;
    in-out property <string> max-tokens-str: "4000";
    in-out property <bool> auto-speak: true;
    in-out property <bool> show-api-key: false;
    in-out property <string> config-path: "";
    in-out property <string> remote-status: "未连接桌面端";
    in-out property <bool> remote-connected: false;
    in-out property <image> remote-pairing-qr;
    in-out property <image> remote-scan-preview;
    in-out property <bool> remote-scanning: false;
    // 由 Rust 侧根据 target_os 设置
    in-out property <bool> is-mobile: false;

    callback text-submitted(string);
    callback toggle-listening();
    callback confirm-action();
    callback cancel-action();
    callback open-settings();
    callback close-settings();
    callback provider-changed(string);
    callback api-key-changed(string);
    callback api-url-changed(string);
    callback model-changed(string);
    callback wire-api-changed(string);
    callback reasoning-effort-changed(string);
    callback store-responses-changed(bool);
    callback max-tokens-changed(string);
    callback auto-speak-changed(bool);
    callback toggle-api-key-visible();
    callback save-settings();
    callback test-connection();
    callback scan-remote();
    callback cancel-remote-scan();
    callback disconnect-remote();

    // 将 is-mobile 传递给 AppTheme 全局单例
    init => {
        AppTheme.is-mobile = root.is-mobile;
    }

    // 监听 is-mobile 变化同步到 AppTheme
    changed is-mobile => {
        AppTheme.is-mobile = root.is-mobile;
    }

    PairingScreen {
        remote-status: root.remote-status;
        remote-connected: root.remote-connected;
        pairing-qr: root.remote-pairing-qr;
        open-settings => { root.open-settings(); }
    }

    if root.show-settings: SettingsPopup {
        provider: root.provider;
        api-key: root.api-key;
        api-url: root.api-url;
        model: root.model;
        wire-api: root.wire-api;
        reasoning-effort: root.reasoning-effort;
        store-responses: root.store-responses;
        max-tokens-str: root.max-tokens-str;
        auto-speak: root.auto-speak;
        show-api-key: root.show-api-key;
        is-busy: root.is-busy;
        config-path: root.config-path;
        remote-status: root.remote-status;
        remote-connected: root.remote-connected;
        remote-pairing-qr: root.remote-pairing-qr;
        remote-scan-preview: root.remote-scan-preview;
        remote-scanning: root.remote-scanning;
        is-mobile: root.is-mobile;

        provider-changed(text) => { root.provider-changed(text); }
        api-key-changed(text) => { root.api-key-changed(text); }
        api-url-changed(text) => { root.api-url-changed(text); }
        model-changed(text) => { root.model-changed(text); }
        wire-api-changed(value) => { root.wire-api-changed(value); }
        reasoning-effort-changed(value) => { root.reasoning-effort-changed(value); }
        store-responses-changed(value) => { root.store-responses-changed(value); }
        max-tokens-changed(text) => { root.max-tokens-changed(text); }
        auto-speak-changed(val) => { root.auto-speak-changed(val); }
        toggle-api-key-visible => { root.toggle-api-key-visible(); }
        save-settings => { root.save-settings(); }
        test-connection => { root.test-connection(); }
        scan-remote => { root.scan-remote(); }
        cancel-remote-scan => { root.cancel-remote-scan(); }
        disconnect-remote => { root.disconnect-remote(); }
        close-settings => { root.close-settings(); }
    }
}
