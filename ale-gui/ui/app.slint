import { Palette, ScrollView } from "std-widgets.slint";
import "assets/Roboto.ttf";
import "assets/RobotoSlab.ttf";
import "assets/JetBrainsMono.ttf";
import { Ui, DeviceRow, ModelRow, LogRow } from "state.slint";
import { AppTheme, ActionButton, Panel } from "widgets.slint";
import { PairingScreen } from "pairing.slint";
import { MainScreen } from "main-screen.slint";
import { SettingsPage } from "settings-page.slint";
export { Ui, AppTheme, DeviceRow, ModelRow, LogRow, Palette }
export component AppWindow inherits Window {
    title: "Ale, My Eyes!";
    preferred-width: 1032px; preferred-height: 800px;
    min-width: 440px; min-height: 640px;
    background: AppTheme.background;
    default-font-size: 14px;
    default-font-family: "Roboto";
    init => { Ui.compact = root.width < 760px; }
    changed width => { Ui.compact = root.width < 760px; }
    in property <string> theme: Ui.theme;
    changed theme => { Palette.color-scheme = root.theme == "dark" ? ColorScheme.dark : root.theme == "light" ? ColorScheme.light : ColorScheme.unknown; }
    VerticalLayout {
        spacing: 0; padding: 0;
        Rectangle {
            height: root.width < 760px ? 112px : 64px;
            background: AppTheme.surface;
            border-width: 1px; border-color: AppTheme.border;
            brand := HorizontalLayout {
                x: 24px; y: 18px; width: 180px; height: 28px; spacing: 10px;
                Image { source: @image-url("assets/accessibility.svg"); width: 28px; height: 28px; colorize: AppTheme.accent; }
                Text { text: "Ale-my-Eyes!"; font-size: 16px; font-weight: 700; color: AppTheme.text; vertical-alignment: center; }
            }
            HorizontalLayout {
                x: root.width < 760px ? 16px : 220px;
                y: root.width < 760px ? 60px : 10px;
                width: root.width < 760px ? parent.width - 32px : 400px;
                height: 44px; spacing: 8px;
                alignment: start;
                ActionButton { text: Ui.tr("配对", "Pairing"); icon: @image-url("assets/pair.svg"); flat: true; selected: Ui.page == "pairing"; clicked => { Ui.navigate("pairing"); } }
                ActionButton { text: Ui.tr("工作", "Work"); icon: @image-url("assets/work.svg"); flat: true; selected: Ui.page == "main"; enabled: Ui.connected; clicked => { Ui.navigate("main"); } }
                ActionButton { text: Ui.tr("设置", "Settings"); icon: @image-url("assets/settings.svg"); flat: true; selected: Ui.page == "settings"; clicked => { Ui.navigate("settings"); } }
            }
        }
        if Ui.page == "pairing": PairingScreen { vertical-stretch: 1; }
        if Ui.page == "main": MainScreen { vertical-stretch: 1; }
        if Ui.page == "settings": SettingsPage { vertical-stretch: 1; }
    }
    if Ui.leave-prompt: Rectangle {
        background: #00000088;
        TouchArea {}
        Panel {
            width: min(parent.width - 40px, 420px); height: 224px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            VerticalLayout {
                alignment: start;
                padding: 24px; spacing: 16px;
                Text { text: Ui.tr("保存更改？", "Save changes?"); font-size: 22px; color: AppTheme.text; }
                Text { text: Ui.tr("设置中有尚未保存的更改。", "Your settings have unsaved changes."); wrap: word-wrap; color: AppTheme.muted; }
                ActionButton { text: Ui.tr("保存", "Save"); modal-control: true; primary: true; enabled: !Ui.busy; clicked => { Ui.leave(1); } }
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton { text: Ui.tr("放弃", "Discard"); modal-control: true; enabled: !Ui.busy; clicked => { Ui.leave(2); } }
                    ActionButton { text: Ui.tr("继续编辑", "Keep editing"); modal-control: true; auto-focus: true; clicked => { Ui.leave(0); } }
                }
            }
        }
    }
    if Ui.test-prompt: Rectangle {
        background: #00000088;
        TouchArea {}
        Panel {
            width: min(parent.width - 40px, 480px); height: 360px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 24px; spacing: 16px; alignment: start;
                Text { text: Ui.tr("测试模型能力？", "Test model capabilities?"); color: AppTheme.text; font-size: 22px; }
                Text { text: Ui.tr("将发送内置测试样例，可能产生少量推理费用。", "Built-in samples will be sent. Small inference charges may apply."); wrap: word-wrap; color: AppTheme.text; }
                ScrollView { height: 100px; VerticalLayout { alignment: start; Text { text: Ui.test-targets; color: AppTheme.muted; wrap: word-wrap; } } }
                ActionButton { text: Ui.tr("开始完整测试", "Start full test"); modal-control: true; primary: true; clicked => { Ui.run-test(); } }
                ActionButton { text: Ui.tr("取消", "Cancel"); modal-control: true; auto-focus: true; clicked => { Ui.test-prompt = false; } }
            }
        }
    }
}
