import { LineEdit, ComboBox, Switch, ScrollView } from "std-widgets.slint";
import { Ui } from "state.slint";
import { AppTheme, ActionButton, Panel, SectionTitle, Field } from "widgets.slint";
export component SettingsPage inherits Rectangle {
    background: AppTheme.background;
    ScrollView {
        width: parent.width; height: parent.height;
        VerticalLayout {
            alignment: start;
            padding: root.width < 760px ? 24px : 40px; spacing: 24px;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: start;
                    width: min(root.width - 48px, 680px); spacing: 28px;
                    Text { text: Ui.tr("设置", "Settings"); font-size: 32px; font-weight: 700; color: AppTheme.text; }
                    Panel {
                        VerticalLayout {
                            alignment: start;
                            padding: 24px; spacing: 20px;
                            SectionTitle { text: Ui.tr("API 配置", "API configuration"); icon: @image-url("assets/language.svg"); padding: 0px; }
                            Field {
                                label: Ui.tr("服务商", "Provider");
                                GridLayout {
                                    spacing: 6px;
                                    ActionButton { row: 0; col: 0; text: "Anthropic"; selected: Ui.provider == "anthropic"; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; clicked => { Ui.provider-selected("anthropic"); } }
                                    ActionButton { row: 0; col: 1; text: "OpenAI"; selected: Ui.provider == "openai"; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; clicked => { Ui.provider-selected("openai"); } }
                                    ActionButton { row: Ui.compact ? 1 : 0; col: Ui.compact ? 0 : 2; text: "Google"; selected: Ui.provider == "google"; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; clicked => { Ui.provider-selected("google"); } }
                                    ActionButton { row: Ui.compact ? 1 : 0; col: Ui.compact ? 1 : 3; text: Ui.tr("其他", "Other"); selected: Ui.provider != "anthropic" && Ui.provider != "openai" && Ui.provider != "google"; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; clicked => { Ui.provider-selected("custom"); } }
                                }
                            }
                            if Ui.provider != "anthropic" && Ui.provider != "openai" && Ui.provider != "google": Field {
                                label: Ui.tr("服务商标识", "Provider ID");
                                LineEdit { accessible-label: Ui.tr("服务商标识", "Provider ID"); text <=> Ui.provider; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; edited => { Ui.edited(); } }
                            }
                            Field {
                                label: Ui.tr("接口协议", "API protocol");
                                ComboBox { accessible-label: Ui.tr("接口协议", "API protocol"); model: ["OpenAI Chat Completions", "OpenAI Responses", "Anthropic Messages", "Google Gemini"]; current-index <=> Ui.wire-api; enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; selected(value) => { Ui.edited(); } }
                            }
                            Field {
                                label: "API Key";
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { accessible-label: "API Key"; text <=> Ui.api-key; input-type: Ui.reveal-key ? InputType.text : InputType.password; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; edited => { Ui.edited(); } }
                                    ActionButton { text: Ui.reveal-key ? Ui.tr("隐藏", "Hide") : Ui.tr("显示", "Show"); clicked => { Ui.reveal(); } }
                                }
                                Text { text: Ui.tr("密钥仅存于系统密钥库，不写入明文配置文件。", "Keys are stored in the system credential store, not in the configuration file."); color: AppTheme.muted; font-size: 12px; wrap: word-wrap; }
                            }
                            Field {
                                label: Ui.tr("API 地址", "API endpoint");
                                LineEdit { accessible-label: Ui.tr("API 地址", "API endpoint"); text <=> Ui.api-url; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; edited => { Ui.edited(); } }
                            }
                            Field {
                                label: Ui.tr("模型", "Model");
                                ComboBox {
                                    accessible-label: Ui.tr("预设模型", "Model preset");
                                    model: Ui.provider == "openai" ? ["gpt-4o", "gpt-4o-mini", Ui.tr("自定义", "Custom")]
                                        : Ui.provider == "anthropic" ? ["claude-sonnet-4-20250514", Ui.tr("自定义", "Custom")]
                                        : Ui.provider == "google" ? ["gemini-2.5-flash", Ui.tr("自定义", "Custom")] : [Ui.tr("自定义", "Custom")];
                                    current-value: Ui.model;
                                    enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt;
                                    selected(value) => { if value != Ui.tr("自定义", "Custom") { Ui.model = value; Ui.edited(); } }
                                }
                                LineEdit { accessible-label: Ui.tr("模型标识", "Model ID"); text <=> Ui.model; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; edited => { Ui.edited(); } }
                            }
                            Field {
                                label: Ui.tr("请求超时（秒）", "Request timeout (seconds)");
                                LineEdit { accessible-label: Ui.tr("请求超时（秒）", "Request timeout in seconds"); text <=> Ui.timeout; input-type: InputType.number; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; edited => { Ui.edited(); } }
                            }
                            ActionButton { text: Ui.advanced ? Ui.tr("收起高级选项", "Hide advanced options") : Ui.tr("高级选项", "Advanced options"); clicked => { Ui.advanced = !Ui.advanced; } }
                            if Ui.advanced: Field {
                                label: Ui.tr("最大输出 Token", "Maximum output tokens");
                                LineEdit { accessible-label: Ui.tr("最大输出 Token", "Maximum output tokens"); text <=> Ui.max-tokens; input-type: InputType.number; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; edited => { Ui.edited(); } }
                            }
                            if Ui.advanced: VerticalLayout {
                                alignment: start; spacing: 16px;
                                Switch { text: Ui.tr("备用模型", "Backup model"); checked <=> Ui.backup-enabled; enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; toggled => { Ui.edited(); } }
                                if Ui.backup-enabled: VerticalLayout {
                                    alignment: start; spacing: 12px;
                                    ComboBox { accessible-label: Ui.tr("备用接口协议", "Backup protocol"); model: ["OpenAI Chat Completions", "OpenAI Responses", "Anthropic Messages", "Google Gemini"]; current-index <=> Ui.backup-wire-api; enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; selected(value) => { Ui.edited(); } }
                                    Field { label: Ui.tr("备用 API 地址", "Backup endpoint"); LineEdit { accessible-label: Ui.tr("备用 API 地址", "Backup endpoint"); text <=> Ui.backup-url;  enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                                    Field { label: Ui.tr("备用 API Key", "Backup API key"); LineEdit { accessible-label: Ui.tr("备用 API Key", "Backup API key"); text <=> Ui.backup-key; input-type: InputType.password; enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                                    Field { label: Ui.tr("备用模型", "Backup model"); LineEdit { accessible-label: Ui.tr("备用模型", "Backup model"); text <=> Ui.backup-model;  enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                                    Field { label: Ui.tr("备用超时（秒）", "Backup timeout"); LineEdit { accessible-label: Ui.tr("备用超时（秒）", "Backup timeout"); text <=> Ui.backup-timeout;  enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                                    Switch { text: Ui.tr("允许自动切换备用端点", "Allow automatic failover"); checked <=> Ui.backup-authorized; enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; toggled => { Ui.edited(); } }
                                }
                            }
                            ActionButton { text: Ui.tr("测试模型能力", "Test capabilities"); enabled: !Ui.busy && Ui.ready; clicked => { Ui.test(); } }
                            if Ui.testing: ActionButton { text: Ui.tr("取消测试", "Cancel test"); clicked => { Ui.cancel-test(); } }
                            if Ui.test-report != "": Text { text: Ui.test-report; color: AppTheme.text; wrap: word-wrap; }

                        }
                    }
                    Panel {
                        VerticalLayout {
                            padding: 24px; spacing: 16px; alignment: start;
                            SectionTitle { text: Ui.tr("云端语音识别", "Cloud transcription"); padding: 0px; }
                            Switch { text: Ui.tr("启用云端转写", "Enable cloud transcription"); checked <=> Ui.asr-enabled; enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; toggled => { Ui.edited(); } }
                            if Ui.asr-enabled: VerticalLayout {
                                alignment: start; spacing: 12px;
                                Field { label: Ui.tr("转写 API 地址", "Transcription endpoint"); LineEdit { accessible-label: Ui.tr("转写 API 地址", "Transcription endpoint"); text <=> Ui.asr-url;  enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                                Field { label: Ui.tr("转写 API Key", "Transcription API key"); LineEdit { accessible-label: Ui.tr("转写 API Key", "Transcription API key"); text <=> Ui.asr-key; input-type: InputType.password; enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                                Field { label: Ui.tr("转写模型", "Transcription model"); LineEdit { accessible-label: Ui.tr("转写模型", "Transcription model"); text <=> Ui.asr-model;  enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                                Field { label: Ui.tr("转写超时（秒）", "Transcription timeout"); LineEdit { accessible-label: Ui.tr("转写超时（秒）", "Transcription timeout"); text <=> Ui.asr-timeout;  enabled: !Ui.busy && !Ui.test-prompt && !Ui.leave-prompt; edited => { Ui.edited(); } } }
                            }
                        }
                    }
                    Panel {
                        VerticalLayout {
                            alignment: start;
                            padding: 24px; spacing: 24px;
                            SectionTitle { text: Ui.tr("辅助功能", "Accessibility"); icon: @image-url("assets/accessibility.svg"); padding: 0px; }
                            Field {
                                label: Ui.tr("界面语言", "Interface language");
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton { text: "中文"; selected: !Ui.english; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; clicked => { Ui.english = false; Ui.edited(); } }
                                    ActionButton { text: "English"; selected: Ui.english; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; clicked => { Ui.english = true; Ui.edited(); } }
                                }
                            }
                            Field {
                                label: Ui.tr("语音播报结果", "Speak responses");
                                Switch { accessible-label: Ui.tr("语音播报结果", "Speak responses"); checked <=> Ui.auto-speak; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; toggled => { Ui.edited(); } }
                            }
                            Field {
                                label: Ui.tr("高对比度模式", "High contrast");
                                Switch { accessible-label: Ui.tr("高对比度模式", "High contrast"); checked <=> Ui.high-contrast; enabled: !Ui.busy && !Ui.leave-prompt && !Ui.test-prompt; toggled => { Ui.edited(); } }
                            }
                        }
                    }
                    Panel {
                        VerticalLayout {
                            alignment: start;
                            padding: 24px; spacing: 20px;
                            SectionTitle { text: Ui.tr("关于", "About"); icon: @image-url("assets/info.svg"); padding: 0px; }
                            for row in [
                                {label: Ui.tr("版本", "Version"), value: Ui.version},
                                {label: Ui.tr("构建日期", "Build date"), value: Ui.build-date},
                                {label: Ui.tr("开源协议", "License"), value: "MIT License"}
                            ]: HorizontalLayout {
                                Text { text: row.label; color: AppTheme.muted; horizontal-stretch: 1; }
                                Text { text: row.value; color: AppTheme.text; }
                            }
                        }
                    }
                    if Ui.feedback != "": Text { text: Ui.feedback; color: Ui.feedback-error ? AppTheme.danger : AppTheme.muted; wrap: word-wrap; }
                    ActionButton { text: Ui.busy ? Ui.tr("处理中…", "Working…") : Ui.tr("保存设置", "Save settings"); icon: @image-url("assets/save.svg"); primary: true; enabled: !Ui.busy && Ui.ready; clicked => { Ui.save(); } }
                }
            }
        }
    }
}
