export struct DeviceRow { id: string, name: string }
export struct ModelRow { name: string, state: string }
export struct LogRow { time: string, message: string, detail: string }
export global Ui {
    in-out property <bool> advanced: false;
    in-out property <int> wire-api: 0;
    in-out property <bool> backup-enabled: false;
    in-out property <bool> backup-authorized: false;
    in-out property <int> backup-wire-api: 0;
    in-out property <string> backup-url: "https://api.openai.com/v1";
    in-out property <string> backup-key: "";
    in-out property <string> backup-model: "gpt-4o";
    in-out property <string> backup-timeout: "30";
    in-out property <bool> asr-enabled: false;
    in-out property <string> asr-url: "https://api.openai.com/v1";
    in-out property <string> asr-key: "";
    in-out property <string> asr-model: "whisper-1";
    in-out property <string> asr-timeout: "30";
    in-out property <bool> test-prompt: false;
    in-out property <bool> testing: false;
    in-out property <string> test-targets: "";
    in-out property <string> test-report: "";
    callback run-test();
    callback cancel-test();
    in-out property <bool> compact: false;
    in-out property <string> theme: "system";
    in-out property <bool> english: false;
    in-out property <bool> high-contrast: false;
    in-out property <string> page: "pairing";
    in-out property <bool> ready: false;
    in-out property <bool> busy: false;
    in-out property <bool> connected: false;
    in-out property <bool> paused: false;
    in-out property <bool> dirty: false;
    in-out property <bool> leave-prompt: false;
    in-out property <bool> reveal-key: false;
    in-out property <bool> auto-speak: true;
    in-out property <bool> feedback-error: false;
    in-out property <string> feedback: "";
    in-out property <string> pairing-status: "";
    in-out property <string> pairing-code: "";
    in-out property <string> pairing-uri: "";
    in-out property <image> qr;
    in-out property <int> remaining: 0;
    in-out property <string> device-name: "";
    in-out property <string> device-address: "";
    in-out property <int> selected-device: 0;
    in-out property <[DeviceRow]> devices;
    in-out property <[string]> device-names;
    in-out property <string> task: "";
    in-out property <string> output: "";
    in-out property <string> decision: "";
    in-out property <string> decision-kind: "";
    in-out property <bool> can-confirm: false;
    in-out property <string> latency: "";
    in-out property <[ModelRow]> models;
    in-out property <[LogRow]> logs;
    in-out property <string> provider: "openai";
    in-out property <string> api-key: "";
    in-out property <string> api-url: "";
    in-out property <string> model: "";
    in-out property <string> timeout: "30";
    in-out property <string> max-tokens: "1024";
    in-out property <string> version: "";
    in-out property <string> build-date: "";
    callback navigate(string);
    callback refresh();
    callback select-device(int);
    callback pause();
    callback disconnect();
    callback decide(bool);
    callback edited();
    callback save();
    callback test();
    callback reveal();
    callback leave(int);
    callback provider-selected(string);
    public pure function tr(zh: string, en: string) -> string { return root.english ? en : zh; }
}
